# 跨平台换行符约定：仓库内统一 LF，避免 Windows 检出成 CRLF 后
# 在 Linux/Cloudflare 构建机上出现 $'\r': command not found。
* text=auto

# 自身与无扩展名配置文件也锁定 LF
.gitattributes text eol=lf
.gitignore     text eol=lf
.npmrc         text eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.cjs  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md   text eol=lf

# 二进制资源不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary